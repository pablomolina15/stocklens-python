# ─── CORS ─────────────────────────────────────────────────────────────────────
# Lista separada por comas de dominios permitidos
# En producción añade tu dominio de Vercel
CORS_ORIGINS=http://localhost:3000,https://tu-app.vercel.app

# ─── Supabase (opcional — para escritura de caché desde Python) ────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# ─── Tunables ─────────────────────────────────────────────────────────────────
CACHE_TTL_PRICES=3600
CACHE_TTL_FUNDAMENTALS=86400
MAX_RETRIES=3
RETRY_DELAY=1.0
